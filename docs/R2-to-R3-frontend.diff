+    return{atk:T.atk*tp(t)*(1+(c.atk||0)),hp:T.hp*tp(t)*(1+(c.hp||0)),type};}
+  window.perTroop3=perTroop3;
+  function armyRows3(){reconcile3();const t=TP(),c=t.c3||{},rows=[];const S=o=>{let s=0;for(const k in o||{})s+=o[k];return s;};
