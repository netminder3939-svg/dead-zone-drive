+.hz-card .crow{grid-column:1/3;display:flex;gap:8px}
+.hz-card .cb{flex:1;min-height:48px;margin:0!important;border-radius:8px!important;border:2px solid #1a1611!important;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2px 4px!important;
+ font:700 12px Cinzel,serif!important;letter-spacing:.5px;color:var(--hz-txt)!important;background:linear-gradient(180deg,#4a443a,#2b2822)!important;box-shadow:inset 0 1px 0 #7a6a50}
+.hz-card .cb small{font:400 10.5px Inter,sans-serif;color:#cfc3a8}
+.hz-card .cb.tox{background:linear-gradient(180deg,#3d5a1e,#24371a)!important;border-color:#12200a!important;color:#d8ffb0!important;box-shadow:inset 0 1px 0 #8fd14f88,0 0 8px #8fd14f55}
+.hz-card .cb:disabled{opacity:.75;filter:grayscale(.6)}
+/* ---- below: spares, sets */
+.hz-more h3{margin-top:4px}
+.hz-row{align-items:center}.hz-ri{flex:none;width:44px;height:44px;border-radius:8px;border:2px solid var(--rc,#4a4234);display:grid;place-items:center;background:radial-gradient(circle,#2c3424,#14160f)}
+.hz-ri img{width:38px;height:38px;object-fit:contain}.hz-ri .hz-emo{font-size:22px}
+.hz-cmp{display:block;margin-top:2px}.hz-cmp .pos{color:#8fd14f}.hz-cmp .neg{color:#ff7a6a}.hz-cmp span{margin-right:6px}
+/* Hero › Stats avatar box shows the same figure */
+.avatarbox .dollbox img.avatar{width:120px;height:150px;object-fit:contain;background:radial-gradient(#2a241c,#16130f);border-radius:12px}
+@media (prefers-reduced-motion:reduce){.hz-fig.hz-fade img.avatar{animation:none}}
+
+.hero-full p.flavor{margin:0 0 6px}
+/* the Gear screen follows the mockup: no flavor line between the tabs and the stage (other Hero tabs keep theirs) */
+#sheetBody[data-hzsub=gear]>p.flavor{display:none}
+/* rarity names on parchment: the same hue, darkened enough to read (text, never color alone) */
+.hz-card .cm b.hz-rar{color:var(--rcol);color:color-mix(in srgb,var(--rcol) 55%,#000)}
