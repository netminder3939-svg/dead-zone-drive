+  window.TERR15=S15;
+  function emit15(){const o={};if(S15.full)Object.assign(o,S15.full);for(const c of Object.values(S15.cells))Object.assign(o,c.docs||{});S15.merged=o;try{S15.cb&&S15.cb({...o});}catch(e){console.warn('terr15 cb',e);}}
