rules_version = '2';
// Dead Zone Drive — friends-and-family rules (free Spark plan, no Cloud Functions).
// Anyone signed in (anonymous is fine) can play. No GPS positions are ever stored.
service cloud.firestore {
  match /databases/{db}/documents {
    match /teams/{team} {
      function signedIn() { return request.auth != null; }
      function nonNegBank(b) {
        return b.keys().hasOnly(['scrap','food','water','fuel','parts'])
          && (!('scrap' in b) || (b.scrap is int && b.scrap >= 0))
          && (!('food'  in b) || (b.food  is int && b.food  >= 0))
          && (!('water' in b) || (b.water is int && b.water >= 0))
          && (!('fuel'  in b) || (b.fuel  is int && b.fuel  >= 0))
          && (!('parts' in b) || (b.parts is int && b.parts >= 0));
      }

      // Member roster: name, level, stronghold level, contribution stats, last active. NO location fields.
      match /players/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid
                     && !request.resource.data.keys().hasAny(['lat','lng','pos','location']);
      }

      // Alliance Bank balances (open access: any member can deposit or withdraw, no limits).
      match /meta/alliance {
        allow read: if signedIn();
        allow create, update: if signedIn() && (!('bank' in request.resource.data) || nonNegBank(request.resource.data.bank));
        allow delete: if false;
      }

      // Bank transaction log: append-only, stamped by the server clock, tied to the signed-in member.
      match /bankLog/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                      && request.resource.data.t == request.time
                      && request.resource.data.res in ['scrap','food','water','fuel','parts']
                      && request.resource.data.amt is int && request.resource.data.bal is int
                      && request.resource.data.get('kind','deposit') in ['deposit','withdraw','auto-share','research'];
        allow update, delete: if false;
      }

      // Activity feed: append-only with server timestamps.
      match /activity/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                      && request.resource.data.t == request.time
                      && request.resource.data.text is string && request.resource.data.text.size() < 200;
        allow update, delete: if false;
      }

      // Fog of war: explored hex ids per member (no coordinates). Only you can add to your own list.
      match /explored/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['ids']);
      }

      // Tactical markers: anyone in the alliance can place or remove them (co-op).
      match /markers/{id} {
        allow read, delete: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.hex is string;
      }

      // Cloud saves (Stage 2): one doc per player. Anyone in the team can READ with the restore code
      // (their player id) to move a save to a new phone; only the owner can write. Profiles hold no GPS.
      match /saves/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid
                     && request.resource.data.data is string && request.resource.data.data.size() < 900000
                     && request.resource.data.rev is int;
      }

      match /territory/{hex} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.resource.data.by is string;
        allow delete: if false;
      }

      match /raids/{raid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.hp == request.resource.data.maxHp;
        allow update: if signedIn() && request.resource.data.hp <= resource.data.hp
                      && request.time.toMillis() < resource.data.endsAt + 60000;
        allow delete: if false;
      }
    }
  }
}
