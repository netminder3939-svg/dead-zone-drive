rules_version = '2';
// Canonical rules candidate. NOT PUBLISHED.
// Publishing this file changes the shared project, including live teams.
// Do not firebase deploy until the coordinator has a separate explicit rules decision.
// Admin bootstrap is teams/{team}/meta/admins {uids:[...]} written from the
// Firebase console (admin SDK bypasses these rules). The game client cannot
// create that doc. No uid is hardcoded here. Until that doc exists, map
// epoch / fullEpoch updates fail closed. Ordinary play does not need it.
service cloud.firestore {
  match /databases/{db}/documents {
    match /teams/{team} {
      function signedIn() { return request.auth != null; }
      function isAdmin() {
        return signedIn()
          && exists(/databases/$(db)/documents/teams/$(team)/meta/admins)
          && request.auth.uid in get(/databases/$(db)/documents/teams/$(team)/meta/admins).data.get('uids', []);
      }
      function nonNegBank(b) {
        return b.keys().hasOnly(['scrap','food','water','fuel','parts'])
          && (!('scrap' in b) || (b.scrap is int && b.scrap >= 0))
          && (!('food'  in b) || (b.food  is int && b.food  >= 0))
          && (!('water' in b) || (b.water is int && b.water >= 0))
          && (!('fuel'  in b) || (b.fuel  is int && b.fuel  >= 0))
          && (!('parts' in b) || (b.parts is int && b.parts >= 0));
      }
      function allianceTouchOk() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['bank','research','ops','acct24','col25']);
      }
      // Second device of the same name+PIN account. The save's acct key must
      // already list both uids. The PIN itself is checked by the client; rules
      // cannot hash it. Listing every save is refused.
      function sameAccount(saveUid) {
        let acct = resource.data.get('acct', '');
        let row = get(/databases/$(db)/documents/teams/$(team)/meta/alliance).data.get('acct24', {}).get(acct, {});
        return acct is string && acct.size() > 0 && acct.size() <= 24
          && row.get('uids', []).hasAny([request.auth.uid])
          && row.get('uids', []).hasAny([saveUid]);
      }

      match /players/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid
                     && !request.resource.data.keys().hasAny(['lat','lng','pos','location']);
      }

      // Crew bank stays a shared hoard: any member may deposit, withdraw, or fund research.
      // They may not write unrelated fields onto this doc (no hidden reset flag).
      match /meta/alliance {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['bank','research','ops','acct24','col25'])
          && (!('bank' in request.resource.data) || nonNegBank(request.resource.data.bank));
        allow update: if signedIn() && allianceTouchOk()
          && (!('bank' in request.resource.data) || nonNegBank(request.resource.data.bank));
        allow delete: if false;
      }

      // Written only from the Firebase console. Clients cannot grant themselves admin.
      match /meta/admins {
        allow read: if signedIn();
        allow create, update, delete: if false;
      }

      match /bankLog/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                      && request.resource.data.t == request.time
                      && request.resource.data.res in ['scrap','food','water','fuel','parts']
                      && request.resource.data.amt is int && request.resource.data.bal is int
                      && request.resource.data.get('kind','deposit') in ['deposit','withdraw','auto-share','research'];
        allow update, delete: if false;
      }

      match /activity/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                      && request.resource.data.t == request.time
                      && request.resource.data.text is string && request.resource.data.text.size() < 200;
        allow update, delete: if false;
      }

      match /explored/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['ids']);
      }

      match /markers/{id} {
        allow read, delete: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.hex is string;
      }

      match /saves/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || sameAccount(uid));
        allow list: if false;
        allow write: if signedIn() && request.auth.uid == uid
                     && request.resource.data.data is string && request.resource.data.data.size() < 900000
                     && request.resource.data.rev is int
                     && (!request.resource.data.keys().hasAny(['acct'])
                         || (request.resource.data.acct is string && request.resource.data.acct.size() <= 24))
                     && (!exists(/databases/$(db)/documents/teams/$(team)/meta/map)
                         || request.resource.data.get('fe', 0) >= get(/databases/$(db)/documents/teams/$(team)/meta/map).data.get('fullEpoch', 0));
      }

      // Epoch and fullEpoch move only for a uid listed in meta/admins.
      match /meta/map {
        allow read: if signedIn();
        allow create: if isAdmin() && request.resource.data.keys().hasOnly(['epoch','fullEpoch'])
                      && request.resource.data.epoch is int && request.resource.data.epoch >= 0
                      && request.resource.data.get('fullEpoch', 0) is int;
        allow update: if isAdmin()
                      && request.resource.data.epoch is int
                      && request.resource.data.epoch > resource.data.epoch
                      && request.resource.data.get('fullEpoch', 0) is int
                      && request.resource.data.get('fullEpoch', 0) >= resource.data.get('fullEpoch', 0)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['epoch','fullEpoch']);
        allow delete: if false;
      }

      match /meta/horde {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.last is int && request.resource.data.fx is string && request.resource.data.fx.size() < 900000;
        allow update: if signedIn() && request.resource.data.last is int && request.resource.data.last > resource.data.last
                      && request.resource.data.fx is string && request.resource.data.fx.size() < 900000;
        allow delete: if false;
      }

      match /clock/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid && request.resource.data.t == request.time;
      }

      match /marches/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.startT == request.time
                      && request.resource.data.state == 'out' && request.resource.data.dur is int && request.resource.data.dur >= 60000;
        allow update: if signedIn() && (
             (resource.data.uid == request.auth.uid && request.resource.data.state == 'arrived' && resource.data.state == 'out'
                && request.time >= resource.data.startT + duration.value(resource.data.dur, 'ms'))
          || (resource.data.uid == request.auth.uid && request.resource.data.state == 'done'
                && request.time >= resource.data.startT + duration.value(resource.data.dur * 2, 'ms'))
          || (resource.data.uid != request.auth.uid && resource.data.state == 'out'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['escorts'])
                && request.time < resource.data.startT + duration.value(resource.data.dur, 'ms'))
          || (resource.data.uid == request.auth.uid
                && request.resource.data.state == resource.data.state
                && request.resource.data.state in ['out','arrived']
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['result','claimed','loot','win','kind'])));
        allow delete: if false;
      }

      function okClaim(d) { return d.get('ai', false) == false && d.get('released', false) == false && d.get('uid', '') == request.auth.uid; }
      function okCapture(d, prevUid) { return d.get('ai', false) == true && d.t is number && d.by.size() > 0
                                         && d.get('capBy', '') == request.auth.uid && d.get('prevUid', '') == prevUid; }
      match /territory/{hex} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.by is string
                      && (okClaim(request.resource.data) || request.resource.data.get('released', false) == true
                          || okCapture(request.resource.data, ''));
        allow update: if signedIn() && request.resource.data.by is string
                      && ((okClaim(request.resource.data) && (resource.data.get('uid', '') in ['', request.auth.uid]
                              || resource.data.get('released', false) == true || resource.data.get('ai', false) == true))
                          || (request.resource.data.get('released', false) == true && resource.data.get('uid', '') in ['', request.auth.uid])
                          || okCapture(request.resource.data, resource.data.get('uid', ''))
                          || (resource.data.get('ai', false) == true && request.resource.data.get('ai', false) == true && okCapture(request.resource.data, resource.data.get('prevUid', ''))));
        allow delete: if false;
      }

      match /raids/{raid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.hp == request.resource.data.maxHp;
        allow update: if signedIn() && request.resource.data.hp <= resource.data.hp
                      && request.resource.data.hp >= resource.data.hp - 1500
                      && request.time.toMillis() < resource.data.endsAt + 60000;
        allow delete: if false;
      }
    }
  }
}
